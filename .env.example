# Database
POSTGRES_USER=finsentiment
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=finsentiment

# Groq API (for RAG chat + agentic AI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Adanos X Stock Sentiment API
ADANOS_API_KEY=your_adanos_api_key_here

# News API keys
GOOGLE_NEWS_API_KEY=your_google_news_key_here

# App settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated CORS origins (no spaces). Example below covers local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Shared API key required by /api/finetuning, /api/chat, /api/ws.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Frontend must send the same key. Vite reads VITE_API_KEY from build env.
VITE_API_KEY=

# FinBERT
FINBERT_MODEL=ProsusAI/finbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
