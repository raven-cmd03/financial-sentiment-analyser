# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the secrets before running
# `docker compose up`. Everything runs on free tiers.
# ──────────────────────────────────────────────────────────────────────────────

# Database (no default on POSTGRES_PASSWORD — compose refuses to start without it)
POSTGRES_USER=finsentiment
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=finsentiment

# Groq (RAG chat). Grab a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Adanos X (Twitter) stock sentiment. Optional — social dashboards no-op
# gracefully when unset.
ADANOS_API_KEY=

# News providers
# Google News RSS needs no key. Alpha Vantage is optional; when set we use
# both its NEWS_SENTIMENT feed and TIME_SERIES_DAILY for correlation prices.
# Free key: https://www.alphavantage.co/support/#api-key
GOOGLE_NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# App settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated CORS origins (no spaces). Example below covers local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Shared API key required by /api/finetuning, /api/chat, /api/ws.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Frontend must send the same key. Vite reads VITE_API_KEY from build env.
VITE_API_KEY=

# Sentiment model. Default: yiyanghkust/finbert-tone (trained on 10k
# analyst-report sentences, better accuracy on financial news than
# ProsusAI/finbert). The analyzer auto-detects the label-index mapping
# from model.config.id2label, so you can drop in any HF 3-class
# sentiment checkpoint (e.g. ahmedrachid/FinancialBERT-Sentiment-Analysis
# or a fine-tuned LoRA merge) without code changes.
FINBERT_MODEL=yiyanghkust/finbert-tone
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
